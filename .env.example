# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID from the same page -> General Information
DISCORD_CLIENT_ID=
# Leave this EMPTY for a public bot: commands then register globally and work in
# every server the bot is in. Set it to a single server id only as a testing
# shortcut for instant updates -- guild commands apply to that server alone, and
# registering the same command globally too makes it appear twice there.
DISCORD_GUILD_ID=
# Path to the SQLite file
DATABASE_PATH=./roulette.db
